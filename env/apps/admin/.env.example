# Staybnb Admin — shared by every mode (Firebase, etc.). Copy to apps/admin/.env.
# URL overrides live in .env.development / .env.production

# Firebase Web SDK (must match the API's Firebase project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set true only to force chart placeholders when the API is offline
VITE_SHOW_DUMMY_DATA=
