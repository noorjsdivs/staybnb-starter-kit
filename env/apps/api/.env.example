# Staybnb API — copy to apps/api/.env and fill in your own values.
# Never commit the real file (the .gitignore keeps it out).

NODE_ENV=development
PORT=8000

# Postgres (matches apps/api/docker-compose.yml)
DATABASE_URL=postgresql://staybnb:staybnb@localhost:5434/staybnb?schema=public
# Production (Neon, part 53):
PRODUCTION_DATABASE_URL=
# DIRECT_DATABASE_URL=

# Auth — a long random string (32+ characters): openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Public URLs of the frontends (used for CORS + Stripe redirects)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
PRODUCTION_CLIENT_URL=
PRODUCTION_ADMIN_URL=
SERVER_URL=http://localhost:8000

# Stripe (test keys locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImageKit (photo uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Firebase Admin — pick ONE of these credential sources
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

# Transactional email (verification links and reset codes).
# Without it, the API prints them in the terminal.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Demo / local only: free wallet deposit + dummy payment capture.
# NEVER enable in production (production always blocks dummy payments).
ALLOW_DUMMY_PAYMENTS=

# Optional
# DEFAULT_USER_IMAGE=
# API_LOG_LEVEL=
